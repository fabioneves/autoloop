{
  "description": "autoloop hooks. Every hook runs the plugin's own copy, finds the project from CLAUDE_PROJECT_DIR, and acts only for the session that owns a run (its latch names the conversation; after --close-run only the command and edit guards act): every other session sees no hook effect.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/tools/session-preflight.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/edit-guard.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/command-guard.mjs\"; s=$?; [ $s -eq 0 ] && exit 0; [ $s -eq 2 ] && exit 2; l=\"$HOME/.claude/autoloop/run-latches/$PPID.json\"; if [ -e \"$l\" ] || [ -L \"$l\" ]; then exit 2; fi; exit 0",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/label-swap-reminder.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/subagent-transcript.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/writeback-check.mjs\"",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
