{
  "description": "autoloop hooks. Every hook runs the plugin's own copy, finds the project from CLAUDE_PROJECT_DIR, and stands down unless it is a devendored autoloop repository (.autoloop/config.json, no vendored guard wired).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/tools/session-preflight.sh\"",
            "timeout": 30,
            "statusMessage": "autoloop preflight (read-only checks)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/edit-guard.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/command-guard.mjs\"; s=$?; [ $s -eq 0 ] && exit 0; [ $s -eq 2 ] && exit 2; r=$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel 2>/dev/null || printf %s \"$CLAUDE_PROJECT_DIR\"); { [ -e \"$r/.autoloop\" ] || [ -L \"$r/.autoloop\" ]; } && exit 2; c=$(git -C \"$r\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && grep -qs '\"baseBranch\":\"' \"$c\"/autoloop/run/*.json && exit 2; exit 0",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/label-swap-reminder.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/subagent-transcript.mjs\"",
            "timeout": 20,
            "statusMessage": "capturing subagent transcript"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/writeback-check.mjs\"",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
